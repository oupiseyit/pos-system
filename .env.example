# Copy to .env and fill in. Never commit .env.
# Generate secrets: openssl rand -base64 24 (password), openssl rand -hex 32 (JWT)

POSTGRES_USER=pos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pos

# For tools run on the host (npx prisma ...). Inside Docker, compose points api at host "postgres".
DATABASE_URL=postgresql://pos:change-me@localhost:5432/pos

JWT_SECRET=change-me-to-32-random-bytes
NODE_ENV=development
PORT=3000
# Login/PIN attempts per minute per IP. 10 in production; raise in dev for automated browser runs.
AUTH_RATE_LIMIT=10

SEED_ADMIN_EMAIL=owner@shop.com
SEED_ADMIN_PASSWORD=change-me

# Production only (see docs/09-deployment.md)
DOMAIN=localhost
BACKUP_PASSPHRASE=change-me

# API tests (npm run db:test -w apps/api). Optional: defaults to DATABASE_URL with database pos_test.
TEST_DATABASE_URL=postgresql://pos:change-me@localhost:5432/pos_test
