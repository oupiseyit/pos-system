{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:seed": "npm run prisma -- db seed",
    "db:reset": "npm run prisma -- migrate reset --force",
    "db:test": "node --env-file-if-exists=../../.env scripts/db-test-reset.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  }
}
