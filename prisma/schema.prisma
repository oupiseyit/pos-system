generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum StockReason {
  SALE
  RECEIVE
  ADJUST
  RETURN
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  passwordHash      String
  pinHash           String?
  role              Role      @default(CASHIER)
  active            Boolean   @default(true)
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  sales          Sale[]          @relation("cashier")
  syncedSales    Sale[]          @relation("syncedBy")
  voidedSales    Sale[]          @relation("voidedBy")
  stockMovements StockMovement[]
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
}

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  sku          String    @unique
  barcode      String?   @unique
  name         String
  categoryId   String?   @db.Uuid
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price        Decimal   @db.Decimal(8, 2)
  cost         Decimal   @default(0) @db.Decimal(8, 2)
  taxRate      Decimal   @default(0) @db.Decimal(8, 2) // percent, 10.00 = 10%
  stockQty     Int       @default(0)
  reorderLevel Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([updatedAt])
  @@index([name])
}

model StockMovement {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @db.Uuid
  product   Product     @relation(fields: [productId], references: [id])
  qtyChange Int
  reason    StockReason
  saleId    String?     @db.Uuid
  sale      Sale?       @relation(fields: [saleId], references: [id])
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  note      String?
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([productId, createdAt])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?  @unique
  email     String?
  notes     String?
  sales     Sale[]
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Sale {
  id         String     @id @db.Uuid // generated by the POS
  receiptNo  String     @unique
  deviceCode String
  cashierId  String     @db.Uuid
  cashier    User       @relation("cashier", fields: [cashierId], references: [id])
  customerId String?    @db.Uuid
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal   Decimal    @db.Decimal(10, 2)
  discount   Decimal    @db.Decimal(10, 2)
  tax        Decimal    @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2)
  status     SaleStatus @default(COMPLETED)
  createdAt  DateTime   @db.Timestamptz
  syncedAt   DateTime   @default(now()) @db.Timestamptz
  syncedById String     @db.Uuid
  syncedBy   User       @relation("syncedBy", fields: [syncedById], references: [id])
  voidedById String?    @db.Uuid
  voidedBy   User?      @relation("voidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?  @db.Timestamptz
  voidReason String?

  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([customerId])
}

model SaleItem {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @db.Uuid
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String  @db.Uuid
  product      Product @relation(fields: [productId], references: [id])
  nameSnapshot String
  unitPrice    Decimal @db.Decimal(8, 2)
  qty          Int
  discount     Decimal @default(0) @db.Decimal(10, 2)
  taxRate      Decimal @db.Decimal(8, 2)
  tax          Decimal @db.Decimal(10, 2)
  lineTotal    Decimal @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @db.Uuid
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  tendered  Decimal?      @db.Decimal(10, 2)
  reference String?

  @@index([saleId])
}

model Setting {
  id            Int      @id @default(1)
  shopName      String   @default("My Shop")
  address       String   @default("")
  phone         String   @default("")
  taxId         String   @default("")
  currency      String   @default("USD")
  timezone      String   @default("UTC")
  receiptFooter String   @default("Thank you!")
  updatedAt     DateTime @updatedAt @db.Timestamptz
}
